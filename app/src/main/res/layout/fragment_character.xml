<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/CardCharacterSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="15dp"
        android:background="@drawable/bg_card_superficie"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ImageCharacterExemple"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginEnd="16dp"
                android:contentDescription="@string/hint_character_name"
                android:scaleType="centerCrop" />

            <EditText
                android:id="@+id/NameCharacterExemple"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:hint="@string/hint_character_name"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="2"
                android:textColor="?attr/colorOnSurface"
                android:textSize="25sp"
                android:textStyle="bold"
                tools:text="Nombre Personaje" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ClassRaceSubclassRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/CardClass"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_fons"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:gravity="center"
                    android:text="@string/title_class"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/SpinnerClass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:backgroundTint="?attr/colorOnSurface"
                    android:entries="@array/classes_array"
                    android:gravity="center"
                    android:spinnerMode="dropdown" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/CardRace"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_fons"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:gravity="center"
                    android:text="@string/title_race"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/SpinnerRace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:backgroundTint="?attr/colorOnSurface"
                    android:entries="@array/races_array"
                    android:gravity="center"
                    android:spinnerMode="dropdown" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/CardSubclass"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_fons"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:gravity="center"
                    android:text="@string/title_subclass"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/SpinnerSubclass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:backgroundTint="?attr/colorOnSurface"
                    android:entries="@array/subclasses_array"
                    android:gravity="center"
                    android:spinnerMode="dropdown" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/CardProficiencyBonus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_card_fons"
                android:elevation="2dp"
                android:gravity="center"
                android:minHeight="54dp"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:gravity="center"
                    android:text="@string/title_proficiency_bonus"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/ProficiencyBonusCharacter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@null"
                    android:gravity="center"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:minWidth="40dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="+2" />
            </LinearLayout>

            <TextView
                android:id="@+id/LevelLabelCharacter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@+id/LevelValueCharacter"
                android:text="@string/title_level"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/LevelValueCharacter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="12dp"
                android:background="@null"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="number"
                android:minWidth="20dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="3" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/LevelProgressCharacter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="40"
                app:indicatorColor="?attr/colorPrimary"
                app:indicatorTrackGapSize="0dp"
                app:trackColor="?attr/android:windowBackground"
                app:trackCornerRadius="5dp"
                app:trackStopIndicatorSize="0dp"
                app:trackThickness="10dp" />

            <ImageView
                android:id="@+id/BtnLevelUp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_boto_rodo"
                android:clickable="true"
                android:contentDescription="@string/title_level"
                android:elevation="2dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:src="@drawable/add_simbol"
                app:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                layout="@layout/character_stats"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3" />

            <include
                layout="@layout/character_details"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="2" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>