<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroud">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/CardCharacterSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            app:cardBackgroundColor="@color/cardBackground"
            app:cardCornerRadius="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Cabecera: foto, nombre y raza · clase -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ImageCharacterExemple"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="16dp"
                        android:scaleType="centerCrop"
                        tools:background="#33FFFFFF" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/NameCharacterExemple"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:text="Nombre Personaje"
                            android:textSize="25sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorText" />

                        <TextView
                            android:id="@+id/RaceAndClassCharacter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:alpha="0.7"
                            android:text="Raza · Clase"
                            android:textSize="16sp"
                            android:textColor="@color/colorText" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Nivel y barra de progreso -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/LevelCharacter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:text="Nivel 3"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorText" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/LevelProgressCharacter"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="40"
                        app:trackThickness="10dp"
                        app:trackCornerRadius="5dp"
                        app:indicatorColor="@color/buttonColor"
                        app:trackColor="@color/backgroud"
                        app:indicatorTrackGapSize="0dp"
                        app:trackStopIndicatorSize="0dp" />
                </LinearLayout>

                <!-- Bloque principal: estadísticas a la izquierda, otra cosa a la derecha -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <!-- Columna izquierda: las 6 estadísticas -->
                    <LinearLayout
                        android:id="@+id/StatsColumn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:orientation="vertical">

                        <!-- Fuerza -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            app:cardBackgroundColor="@color/backgroud"
                            app:cardCornerRadius="12dp"
                            >

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="12dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="8dp"
                                android:paddingBottom="8dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:maxLines="1"
                                    android:text="Fuerza"
                                    android:textColor="@color/colorText"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/StrengthScoreCharacter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="10dp"
                                    android:alpha="0.7"
                                    android:text="15"
                                    android:textColor="@color/colorText"
                                    android:textSize="14sp" />

                                <androidx.cardview.widget.CardView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:cardBackgroundColor="@color/buttonColor"
                                    app:cardCornerRadius="8dp"
                                    >

                                    <TextView
                                        android:id="@+id/StrengthModifierCharacter"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:minWidth="40dp"
                                        android:padding="4dp"
                                        android:text="+2"
                                        android:textColor="@color/colorText"
                                        android:textSize="16sp"
                                        android:textStyle="bold" />
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- Destreza -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            app:cardBackgroundColor="@color/backgroud"
                            app:cardCornerRadius="12dp"
                            >

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="12dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="8dp"
                                android:paddingBottom="8dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:maxLines="1"
                                    android:text="Destreza"
                                    android:textColor="@color/colorText"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/DexterityScoreCharacter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="10dp"
                                    android:alpha="0.7"
                                    android:text="14"
                                    android:textColor="@color/colorText"
                                    android:textSize="14sp" />

                                <androidx.cardview.widget.CardView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:cardBackgroundColor="@color/buttonColor"
                                    app:cardCornerRadius="8dp">

                                    <TextView
                                        android:id="@+id/DexterityModifierCharacter"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:minWidth="40dp"
                                        android:padding="4dp"
                                        android:text="+2"
                                        android:textColor="@color/colorText"
                                        android:textSize="16sp"
                                        android:textStyle="bold" />
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- Constitución -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            app:cardBackgroundColor="@color/backgroud"
                            app:cardCornerRadius="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="12dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="8dp"
                                android:paddingBottom="8dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:maxLines="1"
                                    android:text="Constitución"
                                    android:textColor="@color/colorText"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/ConstitutionScoreCharacter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="10dp"
                                    android:alpha="0.7"
                                    android:text="13"
                                    android:textColor="@color/colorText"
                                    android:textSize="14sp" />

                                <androidx.cardview.widget.CardView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:cardBackgroundColor="@color/buttonColor"
                                    app:cardCornerRadius="8dp">

                                    <TextView
                                        android:id="@+id/ConstitutionModifierCharacter"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:minWidth="40dp"
                                        android:padding="4dp"
                                        android:text="+1"
                                        android:textColor="@color/colorText"
                                        android:textSize="16sp"
                                        android:textStyle="bold" />
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- Inteligencia -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            app:cardBackgroundColor="@color/backgroud"
                            app:cardCornerRadius="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="12dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="8dp"
                                android:paddingBottom="8dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:maxLines="1"
                                    android:text="Inteligencia"
                                    android:textColor="@color/colorText"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/IntelligenceScoreCharacter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="10dp"
                                    android:alpha="0.7"
                                    android:text="10"
                                    android:textColor="@color/colorText"
                                    android:textSize="14sp" />

                                <androidx.cardview.widget.CardView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:cardBackgroundColor="@color/buttonColor"
                                    app:cardCornerRadius="8dp">

                                    <TextView
                                        android:id="@+id/IntelligenceModifierCharacter"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:minWidth="40dp"
                                        android:padding="4dp"
                                        android:text="+0"
                                        android:textColor="@color/colorText"
                                        android:textSize="16sp"
                                        android:textStyle="bold" />
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- Sabiduría -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            app:cardBackgroundColor="@color/backgroud"
                            app:cardCornerRadius="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="12dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="8dp"
                                android:paddingBottom="8dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:maxLines="1"
                                    android:text="Sabiduría"
                                    android:textColor="@color/colorText"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/WisdomScoreCharacter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="10dp"
                                    android:alpha="0.7"
                                    android:text="12"
                                    android:textColor="@color/colorText"
                                    android:textSize="14sp" />

                                <androidx.cardview.widget.CardView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:cardBackgroundColor="@color/buttonColor"
                                    app:cardCornerRadius="8dp">

                                    <TextView
                                        android:id="@+id/WisdomModifierCharacter"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:minWidth="40dp"
                                        android:padding="4dp"
                                        android:text="+1"
                                        android:textColor="@color/colorText"
                                        android:textSize="16sp"
                                        android:textStyle="bold" />
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- Carisma -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/backgroud"
                            app:cardCornerRadius="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="12dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="8dp"
                                android:paddingBottom="8dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:maxLines="1"
                                    android:text="Carisma"
                                    android:textColor="@color/colorText"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/CharismaScoreCharacter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="10dp"
                                    android:alpha="0.7"
                                    android:text="8"
                                    android:textColor="@color/colorText"
                                    android:textSize="14sp" />

                                <androidx.cardview.widget.CardView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:cardBackgroundColor="@color/buttonColor"
                                    app:cardCornerRadius="8dp">

                                    <TextView
                                        android:id="@+id/CharismaModifierCharacter"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:minWidth="40dp"
                                        android:padding="4dp"
                                        android:text="-1"
                                        android:textColor="@color/colorText"
                                        android:textSize="16sp"
                                        android:textStyle="bold" />
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

                    <!-- Columna derecha: aquí irá lo siguiente -->
                    <LinearLayout
                        android:id="@+id/RightColumn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="2"
                        android:orientation="vertical">
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>