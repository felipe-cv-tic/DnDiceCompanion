<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black">
        
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    </LinearLayout>

    <LinearLayout
        android:id="@+id/barraActivities"
        android:layout_width="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_height="150dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@color/buttonColor">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botoBarraActivitiesCharacter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/button_barra"
            android:layout_margin="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="0dp"
            app:backgroundTint="@color/buttonColor"
            app:icon="@drawable/character_icon"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="125dp"
            app:iconTint="@null"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botoBarraActivitiesDice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/button_barra"
            android:layout_margin="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="0dp"
            app:backgroundTint="@color/buttonColor"
            app:icon="@drawable/dice_20"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="125dp"
            app:iconTint="@null"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botoBarraActivitiesSpellbook"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/button_barra"
            android:layout_margin="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="0dp"
            app:backgroundTint="@color/buttonColor"
            app:icon="@drawable/spellbook_icon"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="125dp"
            app:iconTint="@null"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botoBarraActivitiesWeapon"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/button_barra"
            android:layout_margin="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="0dp"
            app:backgroundTint="@color/buttonColor"
            app:icon="@drawable/weapon_icon"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="125dp"
            app:iconTint="@null"/>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>