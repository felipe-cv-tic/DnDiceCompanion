<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="?attr/android:windowBackground"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="@string/roll_dice_title"
        android:textColor="?attr/colorOnSurface"
        android:textSize="28sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/layout_upper_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="32dp">

        <ImageView
            android:id="@+id/iv_dice_image"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/dice_image_desc"
            android:src="@android:drawable/ic_menu_gallery"
            app:tint="?attr/colorTertiary" />

        <TextView
            android:id="@+id/tv_dice_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:text="@string/dice_result_placeholder"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_buttons_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/layout_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_d4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="@string/d4"
                android:contentDescription="@string/d4"
                android:textColor="?attr/colorOnSurface"
                app:backgroundTint="?attr/colorPrimary"
                app:icon="@drawable/dice4"
                app:iconSize="50dp"
                app:iconGravity="top"
                app:iconPadding="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_d6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="@string/d6"
                android:contentDescription="@string/d6"
                android:textColor="?attr/colorOnSurface"
                app:backgroundTint="?attr/colorPrimary"
                app:icon="@drawable/dice6"
                app:iconSize="50dp"
                app:iconGravity="top"
                app:iconPadding="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_d8"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="@string/d8"
                android:contentDescription="@string/d8"
                android:textColor="?attr/colorOnSurface"
                app:backgroundTint="?attr/colorPrimary"
                app:icon="@drawable/dice8"
                app:iconSize="50dp"
                app:iconGravity="top"
                app:iconPadding="4dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_d10"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="@string/d10"
                android:contentDescription="@string/d10"
                android:textColor="?attr/colorOnSurface"
                app:backgroundTint="?attr/colorPrimary"
                app:icon="@drawable/dice10"
                app:iconSize="50dp"
                app:iconGravity="top"
                app:iconPadding="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_d12"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="@string/d12"
                android:contentDescription="@string/d12"
                android:textColor="?attr/colorOnSurface"
                app:backgroundTint="?attr/colorPrimary"
                app:icon="@drawable/dice12"
                app:iconSize="50dp"
                app:iconGravity="top"
                app:iconPadding="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_d20"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="@string/d20"
                android:contentDescription="@string/d20"
                android:textColor="?attr/colorOnSurface"
                app:backgroundTint="?attr/colorPrimary"
                app:icon="@drawable/dice20"
                app:iconSize="50dp"
                app:iconGravity="top"
                app:iconPadding="4dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>