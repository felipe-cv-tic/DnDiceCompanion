<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll_settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:windowBackground"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/main_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/layout_contingut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layout_preferencies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/lbl_preferencies"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="8dp"
                    android:text="@string/pref" />

                <LinearLayout
                    android:id="@+id/layout_propietat_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_propietat_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/propietat_1"
                        android:minHeight="48dp" />

                    <TextView
                        android:id="@+id/lbl_propietat_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginStart="10dp"
                        android:text="@string/propietat_1" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_propietat_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_propietat_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/propietat_2"
                        android:minHeight="48dp" />

                    <TextView
                        android:id="@+id/lbl_propietat_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginStart="10dp"
                        android:text="@string/propietat_2" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_propietat_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_propietat_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/propietat_3"
                        android:minHeight="48dp" />

                    <TextView
                        android:id="@+id/lbl_propietat_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginStart="10dp"
                        android:text="@string/propietat_3" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_propietat_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_propietat_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/propietat_4"
                        android:minHeight="48dp" />

                    <TextView
                        android:id="@+id/lbl_propietat_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginStart="10dp"
                        android:text="@string/propietat_4" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_propietat_5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_propietat_5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/propietat_5"
                        android:minHeight="48dp" />

                    <TextView
                        android:id="@+id/lbl_propietat_5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginStart="10dp"
                        android:text="@string/propietat_5" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_propietat_6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_propietat_6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/propietat_6"
                        android:minHeight="48dp" />

                    <TextView
                        android:id="@+id/lbl_propietat_6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginStart="10dp"
                        android:text="@string/propietat_6" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_accessibilitat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/lbl_accessibilitat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="8dp"
                    android:text="@string/accesi" />

                <LinearLayout
                    android:id="@+id/layout_opcions_accessibilitat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/layout_talkback"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:layout_marginEnd="20dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_talkback"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/talkback"
                            android:padding="10dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            app:backgroundTint="?attr/colorSurface"
                            app:icon="@drawable/talkback"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:cornerRadius="20dp" />

                        <TextView
                            android:id="@+id/lbl_talkback"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:text="@string/talkback" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_contrast"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_contrast"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/contrast"
                            android:padding="10dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            app:backgroundTint="?attr/colorSurface"
                            app:icon="@drawable/contrast"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:cornerRadius="20dp" />

                        <TextView
                            android:id="@+id/lbl_contrast"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:text="@string/contrast" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_login_retorn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_login_retorn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/log"
                android:padding="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:backgroundTint="?attr/colorSurface"
                app:icon="@drawable/login"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:cornerRadius="20dp" />

            <TextView
                android:id="@+id/lbl_login_retorn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:text="@string/log" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>