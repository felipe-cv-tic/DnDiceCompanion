<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_magies"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/android:windowBackground">

    <TextView
        android:id="@+id/TitleMagies"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="@string/title_magies_habilitats"
        android:textColor="?attr/colorOnSurface"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/ScrollViewMagies"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/MagicList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="80dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/CardMagicExemple1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:layout_marginTop="15dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="?attr/colorSurface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/HeaderMagic1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="12dp">

                            <ImageView
                                android:id="@+id/ImageMagicExemple1"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:layout_marginEnd="12dp"
                                android:scaleType="centerCrop"
                                android:contentDescription="@string/magic_image_desc"
                                tools:src="@android:drawable/ic_menu_gallery" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:baselineAligned="false">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/til_nom_magia_1"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="8dp"
                                    android:hint="@string/hint_nom"
                                    android:textColorHint="?attr/colorOnSurfaceVariant"
                                    app:hintTextColor="?attr/colorOnSurface">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/et_nom_magia_1"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface"
                                        android:inputType="textCapWords"
                                        tools:text="Bola de Foc" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/til_stats_magia_1"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="@string/hint_estadistiques"
                                    android:textColorHint="?attr/colorOnSurfaceVariant"
                                    app:hintTextColor="?attr/colorOnSurface">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/et_stats_magia_1"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface"
                                        android:inputType="text"
                                        tools:text="8d6 dany" />

                                </com.google.android.material.textfield.TextInputLayout>

                            </LinearLayout>

                            <ImageView
                                android:id="@+id/btn_expand_magic_1"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginStart="8dp"
                                android:contentDescription="@string/expand_desc"
                                android:src="@android:drawable/arrow_up_float"
                                app:tint="?attr/colorOnSurface" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/LayoutDetailsMagic1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="12dp"
                            android:visibility="visible">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/til_nivell_magia_1"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="8dp"
                                    android:layout_weight="1"
                                    android:hint="@string/hint_nivell_escola"
                                    android:textColorHint="?attr/colorOnSurfaceVariant"
                                    app:hintTextColor="?attr/colorOnSurface">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/et_nivell_magia_1"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface"
                                        tools:text="Nivell 3 (Evocació)" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/til_temps_magia_1"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="@string/hint_temps_llancament"
                                    android:textColorHint="?attr/colorOnSurfaceVariant"
                                    app:hintTextColor="?attr/colorOnSurface">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/et_temps_magia_1"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface"
                                        tools:text="1 acció" />

                                </com.google.android.material.textfield.TextInputLayout>

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/til_abast_magia_1"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="8dp"
                                    android:layout_weight="1"
                                    android:hint="@string/hint_abast"
                                    android:textColorHint="?attr/colorOnSurfaceVariant"
                                    app:hintTextColor="?attr/colorOnSurface">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/et_abast_magia_1"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface"
                                        tools:text="15 metres" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/til_durada_magia_1"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="@string/hint_durada"
                                    android:textColorHint="?attr/colorOnSurfaceVariant"
                                    app:hintTextColor="?attr/colorOnSurface">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/et_durada_magia_1"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface"
                                        tools:text="Instantània" />

                                </com.google.android.material.textfield.TextInputLayout>

                            </LinearLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_components_magia_1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:hint="@string/hint_components"
                                android:textColorHint="?attr/colorOnSurfaceVariant"
                                app:hintTextColor="?attr/colorOnSurface">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_components_magia_1"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:textColor="?attr/colorOnSurface"
                                    tools:text="V, S, M (un polsim de sofre i carbó)" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_desc_magia_1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/hint_descripcio"
                                android:textColorHint="?attr/colorOnSurfaceVariant"
                                app:hintTextColor="?attr/colorOnSurface">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_desc_magia_1"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textMultiLine"
                                    android:minLines="2"
                                    android:textSize="14sp"
                                    android:textColor="?attr/colorOnSurface"
                                    tools:text="Una esfera de foc que explota en un punt a la teva elecció causant dany d'àrea a tots els enemics." />

                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/CardMagicExemple2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:layout_marginTop="15dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="?attr/colorSurface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/HeaderMagic2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="12dp">

                            <ImageView
                                android:id="@+id/ImageMagicExemple2"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:layout_marginEnd="12dp"
                                android:scaleType="centerCrop"
                                android:contentDescription="@string/magic_image_desc"
                                tools:src="@android:drawable/ic_menu_gallery" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:baselineAligned="false">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/til_nom_magia_2"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="8dp"
                                    android:hint="@string/hint_nom"
                                    android:textColorHint="?attr/colorOnSurfaceVariant"
                                    app:hintTextColor="?attr/colorOnSurface">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/et_nom_magia_2"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface"
                                        android:inputType="textCapWords"
                                        tools:text="Raig de Gel" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/til_stats_magia_2"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="@string/hint_estadistiques"
                                    android:textColorHint="?attr/colorOnSurfaceVariant"
                                    app:hintTextColor="?attr/colorOnSurface">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/et_stats_magia_2"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface"
                                        android:inputType="text"
                                        tools:text="1d8 dany" />

                                </com.google.android.material.textfield.TextInputLayout>

                            </LinearLayout>

                            <ImageView
                                android:id="@+id/btn_expand_magic_2"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginStart="8dp"
                                android:contentDescription="@string/expand_desc"
                                android:src="@android:drawable/arrow_down_float"
                                app:tint="?attr/colorOnSurface" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/LayoutDetailsMagic2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="12dp"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="8dp"
                                android:baselineAligned="false">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/til_nivell_magia_2"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="8dp"
                                    android:hint="@string/hint_nivell_escola"
                                    android:textColorHint="?attr/colorOnSurfaceVariant"
                                    app:hintTextColor="?attr/colorOnSurface">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/et_nivell_magia_2"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/til_temps_magia_2"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="@string/hint_temps_llancament"
                                    android:textColorHint="?attr/colorOnSurfaceVariant"
                                    app:hintTextColor="?attr/colorOnSurface">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/et_temps_magia_2"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface" />

                                </com.google.android.material.textfield.TextInputLayout>

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="8dp"
                                android:baselineAligned="false">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/til_abast_magia_2"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="8dp"
                                    android:hint="@string/hint_abast"
                                    android:textColorHint="?attr/colorOnSurfaceVariant"
                                    app:hintTextColor="?attr/colorOnSurface">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/et_abast_magia_2"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/til_durada_magia_2"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="@string/hint_durada"
                                    android:textColorHint="?attr/colorOnSurfaceVariant"
                                    app:hintTextColor="?attr/colorOnSurface">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/et_durada_magia_2"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface" />

                                </com.google.android.material.textfield.TextInputLayout>

                            </LinearLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_components_magia_2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:hint="@string/hint_components"
                                android:textColorHint="?attr/colorOnSurfaceVariant"
                                app:hintTextColor="?attr/colorOnSurface">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_components_magia_2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:textColor="?attr/colorOnSurface" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_desc_magia_2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/hint_descripcio"
                                android:textColorHint="?attr/colorOnSurfaceVariant"
                                app:hintTextColor="?attr/colorOnSurface">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_desc_magia_2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:textColor="?attr/colorOnSurface"
                                    android:inputType="textMultiLine"
                                    android:minLines="2" />

                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/AddMagic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:contentDescription="@string/add_magic_desc"
            app:srcCompat="@android:drawable/ic_input_add"
            android:backgroundTint="?attr/colorPrimary" />

    </FrameLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_search_magies"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:hint="@string/search_hint_magies"
        android:textColorHint="?attr/colorOnSurfaceVariant"
        app:hintTextColor="?attr/colorOnSurface"
        app:startIconDrawable="@android:drawable/ic_menu_search"
        app:startIconTint="?attr/colorOnSurface">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_search_magies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>