<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/android:windowBackground">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/contenedorFragments"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        tools:layout="@layout/fragment_character_list" />

    <LinearLayout
        android:id="@+id/barraActivities"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:orientation="horizontal"
        android:background="?attr/colorPrimary">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botoBarraActivitiesCharacter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/button_barra"
            android:contentDescription="@string/nav_character"
            android:layout_margin="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="0dp"
            app:backgroundTint="?attr/colorPrimary"
            app:icon="@drawable/character_icon"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="50dp"
            app:iconTint="@null"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botoBarraActivitiesDice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/button_barra"
            android:contentDescription="@string/nav_dice"
            android:layout_margin="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="0dp"
            app:backgroundTint="?attr/colorPrimary"
            app:icon="@drawable/dice20"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="50dp"
            app:iconTint="@null"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botoBarraActivitiesSpellbook"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/button_barra"
            android:contentDescription="@string/nav_spells"
            android:layout_margin="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="0dp"
            app:backgroundTint="?attr/colorPrimary"
            app:icon="@drawable/spellbook_icon"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="50dp"
            app:iconTint="@null"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botoBarraActivitiesWeapon"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/button_barra"
            android:contentDescription="@string/nav_weapons"
            android:layout_margin="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="0dp"
            app:backgroundTint="?attr/colorPrimary"
            app:icon="@drawable/weapon_icon"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="50dp"
            app:iconTint="@null"/>

    </LinearLayout>
</LinearLayout>