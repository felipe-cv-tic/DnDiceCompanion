<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_armes"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/android:windowBackground">

    <TextView
        android:id="@+id/TitleArmes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="@string/title_armes_escuts_armadures"
        android:textColor="?attr/colorOnSurface"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/ScrollViewArmes"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/ArmesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="80dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/CardArmaExemple1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:layout_marginTop="15dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="?attr/colorSurface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/HeaderArma1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="12dp">

                            <ImageView
                                android:id="@+id/ImageArmaExemple1"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:layout_marginEnd="12dp"
                                android:scaleType="centerCrop"
                                android:contentDescription="@string/arma_image_desc"
                                tools:src="@android:drawable/ic_menu_gallery" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:baselineAligned="false">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/til_nom_arma_1"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="8dp"
                                    android:hint="@string/hint_nom"
                                    android:textColorHint="?attr/colorOnSurfaceVariant"
                                    app:hintTextColor="?attr/colorOnSurface">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/et_nom_arma_1"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface"
                                        android:inputType="textCapWords"
                                        tools:text="Espasa Llarga" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/til_stats_arma_1"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="@string/hint_estadistiques"
                                    android:textColorHint="?attr/colorOnSurfaceVariant"
                                    app:hintTextColor="?attr/colorOnSurface">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/et_stats_arma_1"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface"
                                        android:inputType="text"
                                        tools:text="1d8 tall" />

                                </com.google.android.material.textfield.TextInputLayout>

                            </LinearLayout>

                            <ImageView
                                android:id="@+id/btn_expand_arma_1"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginStart="8dp"
                                android:contentDescription="@string/expand_desc"
                                android:src="@android:drawable/arrow_up_float"
                                app:tint="?attr/colorOnSurface" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/LayoutDetailsArma1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="12dp"
                            android:visibility="visible">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="8dp"
                                android:baselineAligned="false">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/til_tipus_arma_1"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="8dp"
                                    android:hint="@string/hint_tipus"
                                    android:textColorHint="?attr/colorOnSurfaceVariant"
                                    app:hintTextColor="?attr/colorOnSurface">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/et_tipus_arma_1"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface"
                                        tools:text="Arma cos a cos marcial" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/til_propietats_arma_1"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="@string/hint_propietats"
                                    android:textColorHint="?attr/colorOnSurfaceVariant"
                                    app:hintTextColor="?attr/colorOnSurface">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/et_propietats_arma_1"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface"
                                        tools:text="Versàtil (1d10)" />

                                </com.google.android.material.textfield.TextInputLayout>

                            </LinearLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_mestratge_arma_1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:hint="@string/hint_mestratge"
                                android:textColorHint="?attr/colorOnSurfaceVariant"
                                app:hintTextColor="?attr/colorOnSurface">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_mestratge_arma_1"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:textColor="?attr/colorOnSurface"
                                    tools:text="Eslat (Topple)" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="8dp"
                                android:baselineAligned="false">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/til_pes_arma_1"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="8dp"
                                    android:hint="@string/hint_pes"
                                    android:textColorHint="?attr/colorOnSurfaceVariant"
                                    app:hintTextColor="?attr/colorOnSurface">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/et_pes_arma_1"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface"
                                        tools:text="3 lb." />

                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/til_preu_arma_1"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="@string/hint_preu"
                                    android:textColorHint="?attr/colorOnSurfaceVariant"
                                    app:hintTextColor="?attr/colorOnSurface">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/et_preu_arma_1"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface"
                                        tools:text="15 po" />

                                </com.google.android.material.textfield.TextInputLayout>

                            </LinearLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_desc_arma_1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/hint_descripcio"
                                android:textColorHint="?attr/colorOnSurfaceVariant"
                                app:hintTextColor="?attr/colorOnSurface">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_desc_arma_1"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:textColor="?attr/colorOnSurface"
                                    android:inputType="textMultiLine"
                                    android:minLines="2"
                                    tools:text="Una espasa de doble tall d'acer de gran qualitat, equilibrada per a combat amb una o dues mans." />

                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/CardArmaExemple2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:layout_marginTop="15dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="?attr/colorSurface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/HeaderArma2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="12dp">

                            <ImageView
                                android:id="@+id/ImageArmaExemple2"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:layout_marginEnd="12dp"
                                android:scaleType="centerCrop"
                                android:contentDescription="@string/arma_image_desc"
                                tools:src="@android:drawable/ic_menu_gallery" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:baselineAligned="false">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/til_nom_arma_2"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="8dp"
                                    android:hint="@string/hint_nom"
                                    android:textColorHint="?attr/colorOnSurfaceVariant"
                                    app:hintTextColor="?attr/colorOnSurface">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/et_nom_arma_2"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface"
                                        android:inputType="textCapWords"
                                        tools:text="Escut de Fusta" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/til_stats_arma_2"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="@string/hint_estadistiques"
                                    android:textColorHint="?attr/colorOnSurfaceVariant"
                                    app:hintTextColor="?attr/colorOnSurface">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/et_stats_arma_2"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface"
                                        android:inputType="text"
                                        tools:text="+2 CA" />

                                </com.google.android.material.textfield.TextInputLayout>

                            </LinearLayout>

                            <ImageView
                                android:id="@+id/btn_expand_arma_2"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginStart="8dp"
                                android:contentDescription="@string/expand_desc"
                                android:src="@android:drawable/arrow_down_float"
                                app:tint="?attr/colorOnSurface" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/LayoutDetailsArma2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="12dp"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="8dp"
                                android:baselineAligned="false">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/til_tipus_arma_2"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="8dp"
                                    android:hint="@string/hint_tipus"
                                    android:textColorHint="?attr/colorOnSurfaceVariant"
                                    app:hintTextColor="?attr/colorOnSurface">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/et_tipus_arma_2"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/til_propietats_arma_2"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="@string/hint_propietats"
                                    android:textColorHint="?attr/colorOnSurfaceVariant"
                                    app:hintTextColor="?attr/colorOnSurface">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/et_propietats_arma_2"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface" />

                                </com.google.android.material.textfield.TextInputLayout>

                            </LinearLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_mestratge_arma_2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:hint="@string/hint_mestratge"
                                android:textColorHint="?attr/colorOnSurfaceVariant"
                                app:hintTextColor="?attr/colorOnSurface">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_mestratge_arma_2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:textColor="?attr/colorOnSurface" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="8dp"
                                android:baselineAligned="false">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/til_pes_arma_2"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="8dp"
                                    android:hint="@string/hint_pes"
                                    android:textColorHint="?attr/colorOnSurfaceVariant"
                                    app:hintTextColor="?attr/colorOnSurface">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/et_pes_arma_2"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/til_preu_arma_2"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="@string/hint_preu"
                                    android:textColorHint="?attr/colorOnSurfaceVariant"
                                    app:hintTextColor="?attr/colorOnSurface">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/et_preu_arma_2"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface" />

                                </com.google.android.material.textfield.TextInputLayout>

                            </LinearLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_desc_arma_2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/hint_descripcio"
                                android:textColorHint="?attr/colorOnSurfaceVariant"
                                app:hintTextColor="?attr/colorOnSurface">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_desc_arma_2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:textColor="?attr/colorOnSurface"
                                    android:inputType="textMultiLine"
                                    android:minLines="2" />

                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/AddArma"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:contentDescription="@string/add_arma_desc"
            app:srcCompat="@android:drawable/ic_input_add"
            android:backgroundTint="?attr/colorPrimary" />

    </FrameLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_search_armes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:hint="@string/search_hint_armes"
        android:textColorHint="?attr/colorOnSurfaceVariant"
        app:hintTextColor="?attr/colorOnSurface"
        app:startIconDrawable="@android:drawable/ic_menu_search"
        app:startIconTint="?attr/colorOnSurface">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_search_armes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>